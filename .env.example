BOT_TOKEN=
API_SECRET_KEY=generate-a-long-random-secret
ADMIN_IDS=123456789
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
APP_ENV=production
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me-before-deploy
DATABASE_URL=postgresql+asyncpg://atcivperson:change-me-before-deploy@postgres:5432/atcivperson
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data

# Optional: Telegram chat ID where worker delivery/error notifications are sent (not ADMIN_IDS).
LOG_CHAT_ID=

# AI response probabilities are configured in the bot's runtime settings menu.

# Required only when saving proxy settings for accounts. Generate a random key with cryptography. Keep it stable.
PROXY_ENCRYPTION_KEY=
